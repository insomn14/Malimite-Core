# ── Slack credentials (REQUIRED) ─────────────────────────────────────────────
# Get these from https://api.slack.com/apps after creating your app.
SLACK_APP_TOKEN=xapp-1-...           # Socket Mode app-level token
SLACK_BOT_TOKEN=xoxb-...             # Bot OAuth token

# ── Malimite server (REQUIRED) ───────────────────────────────────────────────
# Base URL of a running malimite-web server. The bot does not scan locally: it calls the same
# POST /api/v1/scans the web UI uses, so its scans also appear in the web UI for triage.
MALIMITE_URL=http://127.0.0.1:7070
# Server API key — required if the server has API_KEY set in its .env (otherwise 401).
MALIMITE_API_KEY=

# ── Access control ───────────────────────────────────────────────────────────
# Comma-separated Slack channel IDs allowed to start scans. Leave empty to allow every channel
# the bot has been invited to. Recommended in a shared workspace: anyone in an allowed channel
# can spend this server's scan capacity (and LLM quota, if LLM_ENABLED is on).
ALLOWED_SLACK_CHANNELS=

# ── Behaviour ────────────────────────────────────────────────────────────────
# Ask the server for LLM enrichment (slower, costs the server's LLM quota). Default: off.
LLM_ENABLED=false

# Max upload size in megabytes (default 300)
MAX_IPA_MB=300
# How many top findings to show inline in the Slack thread
TOP_FINDINGS=5
# Give up waiting for the scan after this many seconds (default 1800 = 30 min)
SCAN_TIMEOUT_S=1800
# Seconds between status polls (default 5)
POLL_INTERVAL_S=5
