# ── Slack credentials (REQUIRED) ─────────────────────────────────────────────
# Get these from https://api.slack.com/apps after creating your app.
SLACK_APP_TOKEN=xapp-1-...           # Socket Mode app-level token
SLACK_BOT_TOKEN=xoxb-...             # Bot OAuth token

# ── Malimite engine ──────────────────────────────────────────────────────────
# Path to the fat CLI JAR. Default tries ../../cli/target/malimite-cli.jar
# MALIMITE_CLI_JAR=/abs/path/to/malimite-cli.jar

GHIDRA_HOME=/usr/share/ghidra
# NOTE: Ghidra 12.1 has a script class-loader regression that breaks our
# DumpClassData.java post-script. Stay on 12.0.4 until upgraded.
SCAN_ROOT=/tmp/malimite-slack

# Max IPA size in megabytes (default 300)
MAX_IPA_MB=300
# How many top findings to show inline in the Slack thread
TOP_FINDINGS=5

# ── LLM (optional) ───────────────────────────────────────────────────────────
LLM_PROVIDER=none                    # none|openai|claude|deepseek|ollama
LLM_MODE=summarize                   # summarize|find_vulns|auto_fix
LLM_MODEL=                           # leave empty for provider default

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_BASE_URL=http://localhost:11434
