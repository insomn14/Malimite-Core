# Copy to .env and fill in
MAILMITE_API_KEY=changeme

# Analysis toolchains
# GHIDRA_HOME=/opt/ghidra   # required for iOS; for Android used on lib/arm64-v8a/*.so
# JADX_HOME=/opt/jadx       # required for Android DEX/Java decompilation

# Learned rules (LLM self-learning) — platform-separated
# MAILMITE_LEARNED_RULES / MAILMITE_LEARNED_RULES_IOS → ~/.mailmite/learned_rules.json
# MAILMITE_LEARNED_RULES_ANDROID → ~/.mailmite/learned_rules_android.json
# MAILMITE_LEARNED_RULES_IOS=
# MAILMITE_LEARNED_RULES_ANDROID=

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=

# Discord bot (optional)
# Enable MESSAGE_CONTENT privileged intent at:
#   https://discord.com/developers/applications → Bot → Privileged Gateway Intents
DISCORD_BOT_TOKEN=

# Slack bot (optional) — Socket Mode, no public endpoint required
# SLACK_APP_TOKEN : xapp-... (Settings → Socket Mode → App-Level Token, scope: connections:write)
# SLACK_BOT_TOKEN : xoxb-... (OAuth & Permissions, scopes: files:read, chat:write, channels:history, im:history)
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
