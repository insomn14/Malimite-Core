# Copy to deploy/.env (kept out of git). docker compose reads it for deploy/web-compose.yml.

# Strongly recommended: the AI Assistant spends your LLM quota. Send it as header X-Api-Key (UI: "API Key" field).
API_KEY=

# Port is published on 127.0.0.1 only. To expose on the LAN set 0.0.0.0 AND API_KEY.
# MALIMITE_BIND=127.0.0.1

# LLM credentials used by scans and by the AI Assistant chat
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# From inside the container, the host's Ollama is host.docker.internal (needs extra_hosts on Linux)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
