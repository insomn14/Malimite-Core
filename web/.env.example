# Copy to .env and fill in values

# Ghidra (iOS Mach-O + Android lib/arm64-v8a/*.so) — must contain support/analyzeHeadless
GHIDRA_HOME=/usr/share/ghidra
# JADX for Android DEX/Java decompilation
JADX_HOME=/opt/jadx

# Path to the fat CLI JAR (auto-detected relative to this file by default)
# CLI_JAR=/path/to/malimite-cli.jar

# Directory where scan outputs are stored
SCAN_DIR=/tmp/malimite-scans

# Server
# loopback by default; set 0.0.0.0 only together with API_KEY
HOST=127.0.0.1
PORT=7070

# API key (header X-Api-Key). Strongly recommended whenever the port is reachable by others:
# the AI Assistant spends your LLM quota. Empty disables auth.
API_KEY=

# LLM defaults (can be overridden per-upload in the UI)
LLM_PROVIDER=none   # none | openai | claude | deepseek | ollama
LLM_MODE=summarize  # summarize | find_vulns | auto_fix | offensive
LLM_MODEL=          # leave empty for provider default

# LLM credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_BASE_URL=http://localhost:11434

# AI Assistant (chat tab) — uses the LLM credentials above; limits are optional
# CHAT_RATE_PER_MIN=30         # global cap on chat requests per minute
# CHAT_MAX_TURNS=20            # max LLM<->tool rounds per message
# CHAT_TOOL_CAP=12000          # max chars of one tool result sent to the model
# HEAVY_CONCURRENCY=1          # concurrent on-demand decompile processes
# GHIDRA_ONDEMAND_TIMEOUT=5400 # seconds before an on-demand decompile is cancelled
